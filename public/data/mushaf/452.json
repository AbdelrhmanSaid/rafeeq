{"page":452,"juz":23,"hizb":46,"lines":[{"segments":[["37:154","ﱁ ﱂ ﱃ ﱄ ﱅ"],["37:155","ﱆ ﱇ ﱈ"],["37:156","ﱉ ﱊ ﱋ ﱌ ﱍ"]]},{"segments":[["37:157","ﱎ ﱏ ﱐ ﱑ ﱒ ﱓ"],["37:158","ﱔ ﱕ ﱖ ﱗ"]]},{"segments":[["37:158","ﱘﱙ ﱚ ﱛ ﱜ ﱝ ﱞ ﱟ"],["37:159","ﱠ ﱡ ﱢ"]]},{"segments":[["37:159","ﱣ ﱤ"],["37:160","ﱥ ﱦ ﱧ ﱨ ﱩ"],["37:161","ﱪ ﱫ ﱬ ﱭ"]]},{"segments":[["37:162","ﱮ ﱯ ﱰ ﱱ ﱲ"],["37:163","ﱳ ﱴ ﱵ ﱶ ﱷ ﱸ"],["37:164","ﱹ ﱺ ﱻ"]]},{"segments":[["37:164","ﱼ ﱽ ﱾ ﱿ"],["37:165","ﲀ ﲁ ﲂ ﲃ"],["37:166","ﲄ ﲅ ﲆ"]]},{"segments":[["37:166","ﲇ"],["37:167","ﲈ ﲉ ﲊ ﲋ"],["37:168","ﲌ ﲍ ﲎ ﲏ ﲐ ﲑ ﲒ"],["37:169","ﲓ"]]},{"segments":[["37:169","ﲔ ﲕ ﲖ ﲗ"],["37:170","ﲘ ﲙﲚ ﲛ ﲜ ﲝ"],["37:171","ﲞ"]]},{"segments":[["37:171","ﲟ ﲠ ﲡ ﲢ ﲣ"],["37:172","ﲤ ﲥ ﲦ ﲧ"]]},{"segments":[["37:173","ﲨ ﲩ ﲪ ﲫ ﲬ"],["37:174","ﲭ ﲮ ﲯ ﲰ ﲱ"],["37:175","ﲲ"]]},{"segments":[["37:175","ﲳ ﲴ ﲵ"],["37:176","ﲶ ﲷ ﲸ"],["37:177","ﲹ ﲺ ﲻ"]]},{"segments":[["37:177","ﲼ ﲽ ﲾ ﲿ"],["37:178","ﳀ ﳁ ﳂ ﳃ ﳄ"],["37:179","ﳅ"]]},{"segments":[["37:179","ﳆ ﳇ ﳈ"],["37:180","ﳉ ﳊ ﳋ ﳌ ﳍ ﳎ"]]},{"segments":[["37:180","ﳏ"],["37:181","ﳐ ﳑ ﳒ ﳓ"],["37:182","ﳔ ﳕ ﳖ ﳗ ﳘ"]]},{"surah":38}],"verses":{"37:154":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","37:155":"أَفَلَا تَذَكَّرُونَ","37:156":"أَمْ لَكُمْ سُلْطَـٰنٌ مُّبِينٌ","37:157":"فَأْتُوا۟ بِكِتَـٰبِكُمْ إِن كُنتُمْ صَـٰدِقِينَ","37:158":"وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ","37:159":"سُبْحَـٰنَ ٱللَّهِ عَمَّا يَصِفُونَ","37:160":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","37:161":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ","37:162":"مَآ أَنتُمْ عَلَيْهِ بِفَـٰتِنِينَ","37:163":"إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ","37:164":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ","37:165":"وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ","37:166":"وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ","37:167":"وَإِن كَانُوا۟ لَيَقُولُونَ","37:168":"لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ","37:169":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","37:170":"فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ","37:171":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ","37:172":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ","37:173":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ","37:174":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ","37:175":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ","37:176":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ","37:177":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ","37:178":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ","37:179":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ","37:180":"سُبْحَـٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ","37:181":"وَسَلَـٰمٌ عَلَى ٱلْمُرْسَلِينَ","37:182":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"}}