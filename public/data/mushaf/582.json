{"page":582,"juz":30,"hizb":59,"lines":[{"surah":78},{"basmala":true},{"segments":[["78:1","ﱁ ﱂ ﱃ"],["78:2","ﱄ ﱅ ﱆ ﱇ"],["78:3","ﱈ ﱉ ﱊ ﱋ ﱌ"]]},{"segments":[["78:4","ﱍ ﱎ ﱏ"],["78:5","ﱐ ﱑ ﱒ ﱓ"],["78:6","ﱔ ﱕ ﱖ ﱗ ﱘ"]]},{"segments":[["78:7","ﱙ ﱚ ﱛ"],["78:8","ﱜ ﱝ ﱞ"],["78:9","ﱟ ﱠ ﱡ"]]},{"segments":[["78:9","ﱢ"],["78:10","ﱣ ﱤ ﱥ ﱦ"],["78:11","ﱧ ﱨ ﱩ ﱪ"],["78:12","ﱫ"]]},{"segments":[["78:12","ﱬ ﱭ ﱮ ﱯ"],["78:13","ﱰ ﱱ ﱲ ﱳ"],["78:14","ﱴ ﱵ"]]},{"segments":[["78:14","ﱶ ﱷ ﱸ ﱹ"],["78:15","ﱺ ﱻ ﱼ ﱽ ﱾ"],["78:16","ﱿ"]]},{"segments":[["78:16","ﲀ ﲁ"],["78:17","ﲂ ﲃ ﲄ ﲅ ﲆ ﲇ"],["78:18","ﲈ ﲉ ﲊ ﲋ"]]},{"segments":[["78:18","ﲌ ﲍ ﲎ"],["78:19","ﲏ ﲐ ﲑ ﲒ ﲓ"],["78:20","ﲔ"]]},{"segments":[["78:20","ﲕ ﲖ ﲗ ﲘ"],["78:21","ﲙ ﲚ ﲛ ﲜ ﲝ"],["78:22","ﲞ"]]},{"segments":[["78:22","ﲟ ﲠ"],["78:23","ﲡ ﲢ ﲣ ﲤ"],["78:24","ﲥ ﲦ ﲧ ﲨ ﲩ ﲪ"]]},{"segments":[["78:24","ﲫ"],["78:25","ﲬ ﲭ ﲮ ﲯ"],["78:26","ﲰ ﲱ ﲲ"],["78:27","ﲳ ﲴ"]]},{"segments":[["78:27","ﲵ ﲶ ﲷ ﲸ"],["78:28","ﲹ ﲺ ﲻ ﲼ"],["78:29","ﲽ ﲾ"]]},{"segments":[["78:29","ﲿ ﳀ ﳁ"],["78:30","ﳂ ﳃ ﳄ ﳅ ﳆ ﳇ"]]}],"verses":{"78:1":" عَمَّ يَتَسَآءَلُونَ","78:2":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","78:3":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","78:4":"كَلَّا سَيَعْلَمُونَ","78:5":"ثُمَّ كَلَّا سَيَعْلَمُونَ","78:6":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا","78:7":"وَٱلْجِبَالَ أَوْتَادًا","78:8":"وَخَلَقْنَـٰكُمْ أَزْوَٰجًا","78:9":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","78:10":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا","78:11":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا","78:12":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا","78:13":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","78:14":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا","78:15":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا","78:16":"وَجَنَّـٰتٍ أَلْفَافًا","78:17":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا","78:18":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا","78:19":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا","78:20":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","78:21":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","78:22":"لِّلطَّـٰغِينَ مَـَٔابًا","78:23":"لَّـٰبِثِينَ فِيهَآ أَحْقَابًا","78:24":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا","78:25":"إِلَّا حَمِيمًا وَغَسَّاقًا","78:26":"جَزَآءً وِفَاقًا","78:27":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا","78:28":"وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا","78:29":"وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا","78:30":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا"}}