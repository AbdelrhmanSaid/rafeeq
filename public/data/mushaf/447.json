{"page":447,"juz":23,"hizb":45,"lines":[{"segments":[["37:25","ﱁ ﱂ ﱃ ﱄ ﱅ"],["37:26","ﱆ ﱇ ﱈ ﱉ ﱊ"],["37:27","ﱋ ﱌ"]]},{"segments":[["37:27","ﱍ ﱎ ﱏ ﱐ"],["37:28","ﱑ ﱒ ﱓ ﱔ ﱕ ﱖ ﱗ"]]},{"segments":[["37:29","ﱘ ﱙ ﱚ ﱛ ﱜ ﱝ"],["37:30","ﱞ ﱟ ﱠ ﱡ ﱢ ﱣﱤ"]]},{"segments":[["37:30","ﱥ ﱦ ﱧ ﱨ ﱩ"],["37:31","ﱪ ﱫ ﱬ ﱭﱮ ﱯ ﱰ ﱱ"]]},{"segments":[["37:32","ﱲ ﱳ ﱴ ﱵ ﱶ"],["37:33","ﱷ ﱸ ﱹ ﱺ ﱻ"]]},{"segments":[["37:33","ﱼ"],["37:34","ﱽ ﱾ ﱿ ﲀ ﲁ"],["37:35","ﲂ ﲃ ﲄ ﲅ ﲆ"]]},{"segments":[["37:35","ﲇ ﲈ ﲉ ﲊ ﲋ ﲌ"],["37:36","ﲍ ﲎ ﲏ ﲐ"]]},{"segments":[["37:36","ﲑ ﲒ ﲓ"],["37:37","ﲔ ﲕ ﲖ ﲗ ﲘ ﲙ"],["37:38","ﲚ"]]},{"segments":[["37:38","ﲛ ﲜ ﲝ ﲞ"],["37:39","ﲟ ﲠ ﲡ ﲢ ﲣ ﲤ"]]},{"segments":[["37:39","ﲥ"],["37:40","ﲦ ﲧ ﲨ ﲩ ﲪ"],["37:41","ﲫ ﲬ ﲭ ﲮ ﲯ"]]},{"segments":[["37:42","ﲰ ﲱ ﲲ ﲳ"],["37:43","ﲴ ﲵ ﲶ ﲷ"],["37:44","ﲸ ﲹ ﲺ"]]},{"segments":[["37:44","ﲻ"],["37:45","ﲼ ﲽ ﲾ ﲿ ﳀ ﳁ"],["37:46","ﳂ ﳃ ﳄ"]]},{"segments":[["37:46","ﳅ"],["37:47","ﳆ ﳇ ﳈ ﳉ ﳊ ﳋ ﳌ ﳍ"],["37:48","ﳎ ﳏ"]]},{"segments":[["37:48","ﳐ ﳑ ﳒ"],["37:49","ﳓ ﳔ ﳕ ﳖ"],["37:50","ﳗ ﳘ ﳙ"]]},{"segments":[["37:50","ﳚ ﳛ ﳜ"],["37:51","ﳝ ﳞ ﳟ ﳠ ﳡ ﳢ ﳣ ﳤ"]]}],"verses":{"37:25":"مَا لَكُمْ لَا تَنَاصَرُونَ","37:26":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ","37:27":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","37:28":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ","37:29":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ","37:30":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ","37:31":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ","37:32":"فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ","37:33":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ","37:34":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","37:35":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ","37:36":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ","37:37":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ","37:38":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ","37:39":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","37:40":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","37:41":"أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ","37:42":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ","37:43":"فِى جَنَّـٰتِ ٱلنَّعِيمِ","37:44":"عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ","37:45":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ","37:46":"بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ","37:47":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ","37:48":"وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ","37:49":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ","37:50":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","37:51":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ"}}