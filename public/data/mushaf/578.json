{"page":578,"juz":29,"hizb":58,"lines":[{"segments":[["75:20","ﱁ ﱂ ﱃ ﱄ ﱅ"],["75:21","ﱆ ﱇ ﱈ"],["75:22","ﱉ ﱊ ﱋ"]]},{"segments":[["75:22","ﱌ"],["75:23","ﱍ ﱎ ﱏ ﱐ"],["75:24","ﱑ ﱒ ﱓ ﱔ"],["75:25","ﱕ ﱖ ﱗ ﱘ"]]},{"segments":[["75:25","ﱙ ﱚ"],["75:26","ﱛ ﱜ ﱝ ﱞ ﱟ"],["75:27","ﱠ ﱡﱢ ﱣ ﱤ"],["75:28","ﱥ ﱦ ﱧ"]]},{"segments":[["75:28","ﱨ"],["75:29","ﱩ ﱪ ﱫ ﱬ"],["75:30","ﱭ ﱮ ﱯ ﱰ ﱱ"],["75:31","ﱲ"]]},{"segments":[["75:31","ﱳ ﱴ ﱵ ﱶ"],["75:32","ﱷ ﱸ ﱹ ﱺ"],["75:33","ﱻ ﱼ ﱽ ﱾ ﱿ"]]},{"segments":[["75:33","ﲀ"],["75:34","ﲁ ﲂ ﲃ ﲄ"],["75:35","ﲅ ﲆ ﲇ ﲈ ﲉ"],["75:36","ﲊ ﲋ"]]},{"segments":[["75:36","ﲌ ﲍ ﲎ ﲏ"],["75:37","ﲐ ﲑ ﲒ ﲓ ﲔ ﲕ ﲖ"],["75:38","ﲗ ﲘ"]]},{"segments":[["75:38","ﲙ ﲚ ﲛ ﲜ"],["75:39","ﲝ ﲞ ﲟ ﲠ"]]},{"segments":[["75:39","ﲡ ﲢ"],["75:40","ﲣ ﲤ ﲥ ﲦ ﲧ ﲨ ﲩ ﲪ"]]},{"surah":76},{"basmala":true},{"segments":[["76:1","ﲫ ﲬ ﲭ ﲮ ﲯ ﲰ ﲱ ﲲ ﲳ ﲴ ﲵ ﲶ"],["76:2","ﲷ ﲸ"]]},{"segments":[["76:2","ﲹ ﲺ ﲻ ﲼ ﲽ ﲾ ﲿ ﳀ ﳁ"],["76:3","ﳂ"]]},{"segments":[["76:3","ﳃ ﳄ ﳅ ﳆ ﳇ ﳈ ﳉ"],["76:4","ﳊ ﳋ ﳌ ﳍ"]]},{"segments":[["76:4","ﳎ ﳏ ﳐ"],["76:5","ﳑ ﳒ ﳓ ﳔ ﳕ ﳖ ﳗ ﳘ ﳙ"]]}],"verses":{"75:20":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","75:21":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ","75:22":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","75:23":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","75:24":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","75:25":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","75:26":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","75:27":"وَقِيلَ مَنْ ۜ رَاقٍ","75:28":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","75:29":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","75:30":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","75:31":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","75:32":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ","75:33":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","75:34":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","75:35":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","75:36":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى","75:37":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ","75:38":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ","75:39":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","75:40":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ","76:1":" هَلْ أَتَىٰ عَلَى ٱلْإِنسَـٰنِ حِينٌ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًٔا مَّذْكُورًا","76:2":"إِنَّا خَلَقْنَا ٱلْإِنسَـٰنَ مِن نُّطْفَةٍ أَمْشَاجٍ نَّبْتَلِيهِ فَجَعَلْنَـٰهُ سَمِيعًۢا بَصِيرًا","76:3":"إِنَّا هَدَيْنَـٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا","76:4":"إِنَّآ أَعْتَدْنَا لِلْكَـٰفِرِينَ سَلَـٰسِلَا۟ وَأَغْلَـٰلًا وَسَعِيرًا","76:5":"إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍ كَانَ مِزَاجُهَا كَافُورًا"}}