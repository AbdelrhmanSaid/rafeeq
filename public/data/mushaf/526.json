{"page":526,"juz":27,"hizb":53,"lines":[{"basmala":true},{"segments":[["53:1","ﱁ ﱂ ﱃ ﱄ"],["53:2","ﱅ ﱆ ﱇ ﱈ ﱉ ﱊ"],["53:3","ﱋ ﱌ ﱍ"]]},{"segments":[["53:3","ﱎ ﱏ"],["53:4","ﱐ ﱑ ﱒ ﱓ ﱔ ﱕ"],["53:5","ﱖ ﱗ ﱘ ﱙ"]]},{"segments":[["53:6","ﱚ ﱛ ﱜ ﱝ"],["53:7","ﱞ ﱟ ﱠ ﱡ"],["53:8","ﱢ ﱣ ﱤ ﱥ"]]},{"segments":[["53:9","ﱦ ﱧ ﱨ ﱩ ﱪ ﱫ"],["53:10","ﱬ ﱭ ﱮ ﱯ ﱰ ﱱ"]]},{"segments":[["53:11","ﱲ ﱳ ﱴ ﱵ ﱶ ﱷ"],["53:12","ﱸ ﱹ ﱺ ﱻ ﱼ"],["53:13","ﱽ ﱾ"]]},{"segments":[["53:13","ﱿ ﲀ ﲁ"],["53:14","ﲂ ﲃ ﲄ ﲅ"],["53:15","ﲆ ﲇ ﲈ ﲉ"]]},{"segments":[["53:16","ﲊ ﲋ ﲌ ﲍ ﲎ ﲏ"],["53:17","ﲐ ﲑ ﲒ ﲓ ﲔ ﲕ"],["53:18","ﲖ ﲗ"]]},{"segments":[["53:18","ﲘ ﲙ ﲚ ﲛ ﲜ"],["53:19","ﲝ ﲞ ﲟ ﲠ"],["53:20","ﲡ"]]},{"segments":[["53:20","ﲢ ﲣ ﲤ"],["53:21","ﲥ ﲦ ﲧ ﲨ ﲩ"],["53:22","ﲪ ﲫ ﲬ"]]},{"segments":[["53:22","ﲭ ﲮ"],["53:23","ﲯ ﲰ ﲱ ﲲ ﲳ ﲴ ﲵ ﲶ ﲷ"]]},{"segments":[["53:23","ﲸ ﲹ ﲺ ﲻﲼ ﲽ ﲾ ﲿ ﳀ ﳁ ﳂ ﳃﳄ"]]},{"segments":[["53:23","ﳅ ﳆ ﳇ ﳈ ﳉ ﳊ"],["53:24","ﳋ ﳌ ﳍ ﳎ ﳏ"],["53:25","ﳐ"]]},{"segments":[["53:25","ﳑ ﳒ ﳓ"],["53:26","ﳔﳕ ﳖ ﳗ ﳘ ﳙ ﳚ ﳛ"]]},{"segments":[["53:26","ﳜ ﳝ ﳞ ﳟ ﳠ ﳡ ﳢ ﳣ ﳤ ﳥ ﳦ ﳧ"]]}],"verses":{"53:1":" وَٱلنَّجْمِ إِذَا هَوَىٰ","53:2":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ","53:3":"وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ","53:4":"إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ","53:5":"عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ","53:6":"ذُو مِرَّةٍ فَٱسْتَوَىٰ","53:7":"وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ","53:8":"ثُمَّ دَنَا فَتَدَلَّىٰ","53:9":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ","53:10":"فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ","53:11":"مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ","53:12":"أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ","53:13":"وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ","53:14":"عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ","53:15":"عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ","53:16":"إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ","53:17":"مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ","53:18":"لَقَدْ رَأَىٰ مِنْ ءَايَـٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ","53:19":"أَفَرَءَيْتُمُ ٱللَّـٰتَ وَٱلْعُزَّىٰ","53:20":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ","53:21":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ","53:22":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ","53:23":"إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ","53:24":"أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ","53:25":"فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ","53:26":"۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ"}}