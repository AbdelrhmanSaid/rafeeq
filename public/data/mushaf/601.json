{"page":601,"juz":30,"hizb":60,"lines":[{"surah":103},{"basmala":true},{"segments":[["103:1","ﱁ ﱂ"],["103:2","ﱃ ﱄ ﱅ ﱆ ﱇ"],["103:3","ﱈ ﱉ ﱊ"]]},{"segments":[["103:3","ﱋ ﱌ ﱍ ﱎ ﱏ ﱐ ﱑ"]]},{"surah":104},{"basmala":true},{"segments":[["104:1","ﱒ ﱓ ﱔ ﱕ ﱖ"],["104:2","ﱗ ﱘ ﱙ ﱚ ﱛ"]]},{"segments":[["104:3","ﱜ ﱝ ﱞ ﱟ ﱠ"],["104:4","ﱡﱢ ﱣ ﱤ ﱥ ﱦ"]]},{"segments":[["104:5","ﱧ ﱨ ﱩ ﱪ ﱫ"],["104:6","ﱬ ﱭ ﱮ ﱯ"],["104:7","ﱰ ﱱ"]]},{"segments":[["104:7","ﱲ ﱳ ﱴ"],["104:8","ﱵ ﱶ ﱷ ﱸ"],["104:9","ﱹ ﱺ ﱻ ﱼ"]]},{"surah":105},{"basmala":true},{"segments":[["105:1","ﱽ ﱾ ﱿ ﲀ ﲁ ﲂ ﲃ ﲄ"],["105:2","ﲅ ﲆ"]]},{"segments":[["105:2","ﲇ ﲈ ﲉ ﲊ"],["105:3","ﲋ ﲌ ﲍ ﲎ ﲏ"]]},{"segments":[["105:4","ﲐ ﲑ ﲒ ﲓ ﲔ"],["105:5","ﲕ ﲖ ﲗ ﲘ"]]}],"verses":{"103:1":" وَٱلْعَصْرِ","103:2":"إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ","103:3":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","104:1":" وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","104:2":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","104:3":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","104:4":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","104:5":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","104:6":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","104:7":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","104:8":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","104:9":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","105:1":" أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ","105:2":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ","105:3":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","105:4":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","105:5":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"}}