{"page":536,"juz":27,"hizb":54,"lines":[{"segments":[["56:51","ﱁ ﱂ ﱃ ﱄ ﱅ ﱆ"],["56:52","ﱇ ﱈ ﱉ ﱊ ﱋ ﱌ"]]},{"segments":[["56:53","ﱍ ﱎ ﱏ ﱐ"],["56:54","ﱑ ﱒ ﱓ ﱔ ﱕ"],["56:55","ﱖ"]]},{"segments":[["56:55","ﱗ ﱘ ﱙ"],["56:56","ﱚ ﱛ ﱜ ﱝ ﱞ"],["56:57","ﱟ ﱠ ﱡ"]]},{"segments":[["56:57","ﱢ ﱣ"],["56:58","ﱤ ﱥ ﱦ ﱧ"],["56:59","ﱨ ﱩ ﱪ ﱫ"]]},{"segments":[["56:59","ﱬ ﱭ"],["56:60","ﱮ ﱯ ﱰ ﱱ ﱲ ﱳ ﱴ ﱵ"]]},{"segments":[["56:61","ﱶ ﱷ ﱸ ﱹ ﱺ ﱻ ﱼ ﱽ ﱾ ﱿ"],["56:62","ﲀ"]]},{"segments":[["56:62","ﲁ ﲂ ﲃ ﲄ ﲅ ﲆ"],["56:63","ﲇ ﲈ ﲉ"]]},{"segments":[["56:63","ﲊ"],["56:64","ﲋ ﲌ ﲍ ﲎ ﲏ ﲐ"],["56:65","ﲑ ﲒ ﲓ"]]},{"segments":[["56:65","ﲔ ﲕ ﲖ ﲗ"],["56:66","ﲘ ﲙ ﲚ"],["56:67","ﲛ ﲜ"]]},{"segments":[["56:67","ﲝ ﲞ"],["56:68","ﲟ ﲠ ﲡ ﲢ ﲣ"],["56:69","ﲤ ﲥ"]]},{"segments":[["56:69","ﲦ ﲧ ﲨ ﲩ ﲪ ﲫ"],["56:70","ﲬ ﲭ ﲮ ﲯ ﲰ"]]},{"segments":[["56:70","ﲱ ﲲ"],["56:71","ﲳ ﲴ ﲵ ﲶ ﲷ"],["56:72","ﲸ ﲹ"]]},{"segments":[["56:72","ﲺ ﲻ ﲼ ﲽ ﲾ"],["56:73","ﲿ ﳀ ﳁ ﳂ"]]},{"segments":[["56:73","ﳃ ﳄ"],["56:74","ﳅ ﳆ ﳇ ﳈ ﳉ"],["56:75","ﳊ ﳋ ﳌ"]]},{"segments":[["56:75","ﳍ ﳎ ﳏ"],["56:76","ﳐ ﳑ ﳒ ﳓ ﳔ ﳕ"]]}],"verses":{"56:51":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ","56:52":"لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ","56:53":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","56:54":"فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ","56:55":"فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ","56:56":"هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ","56:57":"نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ","56:58":"أَفَرَءَيْتُم مَّا تُمْنُونَ","56:59":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ","56:60":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","56:61":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","56:62":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","56:63":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","56:64":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","56:65":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ","56:66":"إِنَّا لَمُغْرَمُونَ","56:67":"بَلْ نَحْنُ مَحْرُومُونَ","56:68":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","56:69":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","56:70":"لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ","56:71":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","56:72":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","56:73":"نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ","56:74":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","56:75":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","56:76":"وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ"}}