{"page":595,"juz":30,"hizb":60,"lines":[{"segments":[["90:19","ﱁ ﱂ ﱃ ﱄ ﱅ ﱆ ﱇ"],["90:20","ﱈ ﱉ ﱊ ﱋ"]]},{"surah":91},{"basmala":true},{"segments":[["91:1","ﱌ ﱍ ﱎ"],["91:2","ﱏ ﱐ ﱑ ﱒ"],["91:3","ﱓ ﱔ ﱕ"]]},{"segments":[["91:3","ﱖ"],["91:4","ﱗ ﱘ ﱙ ﱚ"],["91:5","ﱛ ﱜ ﱝ ﱞ"],["91:6","ﱟ"]]},{"segments":[["91:6","ﱠ ﱡ ﱢ"],["91:7","ﱣ ﱤ ﱥ ﱦ"],["91:8","ﱧ ﱨ"]]},{"segments":[["91:8","ﱩ ﱪ"],["91:9","ﱫ ﱬ ﱭ ﱮ ﱯ"],["91:10","ﱰ ﱱ ﱲ ﱳ"]]},{"segments":[["91:10","ﱴ"],["91:11","ﱵ ﱶ ﱷ ﱸ"],["91:12","ﱹ ﱺ ﱻ ﱼ"],["91:13","ﱽ ﱾ"]]},{"segments":[["91:13","ﱿ ﲀ ﲁ ﲂ ﲃ ﲄ"],["91:14","ﲅ ﲆ ﲇ"]]},{"segments":[["91:14","ﲈ ﲉ ﲊ ﲋ ﲌ"],["91:15","ﲍ ﲎ ﲏ ﲐ"]]},{"surah":92},{"basmala":true},{"segments":[["92:1","ﲑ ﲒ ﲓ ﲔ"],["92:2","ﲕ ﲖ ﲗ ﲘ"],["92:3","ﲙ ﲚ ﲛ ﲜ ﲝ"]]},{"segments":[["92:4","ﲞ ﲟ ﲠ ﲡ"],["92:5","ﲢ ﲣ ﲤ ﲥ ﲦ"],["92:6","ﲧ ﲨ ﲩ"]]},{"segments":[["92:7","ﲪ ﲫ ﲬ"],["92:8","ﲭ ﲮ ﲯ ﲰ ﲱ"],["92:9","ﲲ ﲳ ﲴ"]]}],"verses":{"90:19":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ","90:20":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ","91:1":" وَٱلشَّمْسِ وَضُحَىٰهَا","91:2":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","91:3":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","91:4":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","91:5":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","91:6":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","91:7":"وَنَفْسٍ وَمَا سَوَّىٰهَا","91:8":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","91:9":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","91:10":"وَقَدْ خَابَ مَن دَسَّىٰهَا","91:11":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","91:12":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","91:13":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","91:14":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","91:15":"وَلَا يَخَافُ عُقْبَـٰهَا","92:1":" وَٱلَّيْلِ إِذَا يَغْشَىٰ","92:2":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","92:3":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","92:4":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","92:5":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","92:6":"وَصَدَّقَ بِٱلْحُسْنَىٰ","92:7":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","92:8":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","92:9":"وَكَذَّبَ بِٱلْحُسْنَىٰ"}}