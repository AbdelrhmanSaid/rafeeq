{"page":528,"juz":27,"hizb":53,"lines":[{"segments":[["53:45","ﱁ ﱂ ﱃ ﱄ ﱅ ﱆ"],["53:46","ﱇ ﱈ ﱉ ﱊ"]]},{"segments":[["53:46","ﱋ"],["53:47","ﱌ ﱍ ﱎ ﱏ ﱐ"],["53:48","ﱑ ﱒ ﱓ ﱔ ﱕ"],["53:49","ﱖ"]]},{"segments":[["53:49","ﱗ ﱘ ﱙ ﱚ"],["53:50","ﱛ ﱜ ﱝ ﱞ ﱟ"],["53:51","ﱠ ﱡ"]]},{"segments":[["53:51","ﱢ ﱣ"],["53:52","ﱤ ﱥ ﱦ ﱧﱨ ﱩ ﱪ ﱫ ﱬ ﱭ"]]},{"segments":[["53:52","ﱮ"],["53:53","ﱯ ﱰ ﱱ"],["53:54","ﱲ ﱳ ﱴ ﱵ"],["53:55","ﱶ ﱷ"]]},{"segments":[["53:55","ﱸ ﱹ ﱺ"],["53:56","ﱻ ﱼ ﱽ ﱾ ﱿ ﲀ"],["53:57","ﲁ ﲂ"]]},{"segments":[["53:57","ﲃ"],["53:58","ﲄ ﲅ ﲆ ﲇ ﲈ ﲉ ﲊ"],["53:59","ﲋ ﲌ ﲍ"]]},{"segments":[["53:59","ﲎ ﲏ"],["53:60","ﲐ ﲑ ﲒ ﲓ"],["53:61","ﲔ ﲕ"]]},{"segments":[["53:61","ﲖ"],["53:62","ﲗﲘ ﲙﲚ ﲛﲜ ﲝ"]],"centered":true},{"surah":54},{"basmala":true},{"segments":[["54:1","ﲞ ﲟ ﲠ ﲡ ﲢ"],["54:2","ﲣ ﲤ ﲥ ﲦ ﲧ"]]},{"segments":[["54:2","ﲨ ﲩ ﲪ"],["54:3","ﲫ ﲬ ﲭﲮ ﲯ ﲰ ﲱ ﲲ"]]},{"segments":[["54:4","ﲳ ﲴ ﲵ ﲶ ﲷ ﲸ ﲹ ﲺ"],["54:5","ﲻ ﲼﲽ ﲾ ﲿ"]]},{"segments":[["54:5","ﳀ ﳁ"],["54:6","ﳂ ﳃﳄ ﳅ ﳆ ﳇ ﳈ ﳉ ﳊ ﳋ"]]}],"verses":{"53:45":"وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ","53:46":"مِن نُّطْفَةٍ إِذَا تُمْنَىٰ","53:47":"وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ","53:48":"وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ","53:49":"وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ","53:50":"وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ","53:51":"وَثَمُودَا۟ فَمَآ أَبْقَىٰ","53:52":"وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ","53:53":"وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ","53:54":"فَغَشَّىٰهَا مَا غَشَّىٰ","53:55":"فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ","53:56":"هَـٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ","53:57":"أَزِفَتِ ٱلْـَٔازِفَةُ","53:58":"لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ","53:59":"أَفَمِنْ هَـٰذَا ٱلْحَدِيثِ تَعْجَبُونَ","53:60":"وَتَضْحَكُونَ وَلَا تَبْكُونَ","53:61":"وَأَنتُمْ سَـٰمِدُونَ","53:62":"فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩","54:1":" ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ","54:2":"وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ","54:3":"وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍ مُّسْتَقِرٌّ","54:4":"وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ","54:5":"حِكْمَةٌۢ بَـٰلِغَةٌ ۖ فَمَا تُغْنِ ٱلنُّذُرُ","54:6":"فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍ نُّكُرٍ"}}