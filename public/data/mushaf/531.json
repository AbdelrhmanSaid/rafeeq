{"page":531,"juz":27,"hizb":53,"lines":[{"segments":[["54:50","ﱁ ﱂ ﱃ ﱄ ﱅ ﱆ ﱇ"],["54:51","ﱈ ﱉ"]]},{"segments":[["54:51","ﱊ ﱋ ﱌ ﱍ ﱎ"],["54:52","ﱏ ﱐ ﱑ ﱒ ﱓ"]]},{"segments":[["54:52","ﱔ"],["54:53","ﱕ ﱖ ﱗ ﱘ ﱙ"],["54:54","ﱚ ﱛ"]]},{"segments":[["54:54","ﱜ ﱝ ﱞ ﱟ"],["54:55","ﱠ ﱡ ﱢ ﱣ ﱤ ﱥ ﱦ"]]},{"surah":55},{"basmala":true},{"segments":[["55:1","ﱧ ﱨ"],["55:2","ﱩ ﱪ ﱫ"],["55:3","ﱬ ﱭ ﱮ"],["55:4","ﱯ ﱰ ﱱ"]]},{"segments":[["55:5","ﱲ ﱳ ﱴ ﱵ"],["55:6","ﱶ ﱷ ﱸ ﱹ"]]},{"segments":[["55:7","ﱺ ﱻ ﱼ ﱽ ﱾ"],["55:8","ﱿ ﲀ ﲁ ﲂ ﲃ"]]},{"segments":[["55:9","ﲄ ﲅ ﲆ ﲇ ﲈ ﲉ ﲊ"],["55:10","ﲋ"]]},{"segments":[["55:10","ﲌ ﲍ ﲎ"],["55:11","ﲏ ﲐ ﲑ ﲒ ﲓ ﲔ"]]},{"segments":[["55:12","ﲕ ﲖ ﲗ ﲘ ﲙ"],["55:13","ﲚ ﲛ ﲜ ﲝ"]]},{"segments":[["55:13","ﲞ"],["55:14","ﲟ ﲠ ﲡ ﲢ ﲣ ﲤ"],["55:15","ﲥ ﲦ ﲧ"]]},{"segments":[["55:15","ﲨ ﲩ ﲪ ﲫ"],["55:16","ﲬ ﲭ ﲮ ﲯ ﲰ"],["55:17","ﲱ"]]},{"segments":[["55:17","ﲲ ﲳ ﲴ ﲵ"],["55:18","ﲶ ﲷ ﲸ ﲹ ﲺ"]]}],"verses":{"54:50":"وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌ كَلَمْحٍۭ بِٱلْبَصَرِ","54:51":"وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍ","54:52":"وَكُلُّ شَىْءٍ فَعَلُوهُ فِى ٱلزُّبُرِ","54:53":"وَكُلُّ صَغِيرٍ وَكَبِيرٍ مُّسْتَطَرٌ","54:54":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَنَهَرٍ","54:55":"فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍ مُّقْتَدِرٍۭ","55:1":" ٱلرَّحْمَـٰنُ","55:2":"عَلَّمَ ٱلْقُرْءَانَ","55:3":"خَلَقَ ٱلْإِنسَـٰنَ","55:4":"عَلَّمَهُ ٱلْبَيَانَ","55:5":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ","55:6":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ","55:7":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ","55:8":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ","55:9":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ","55:10":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ","55:11":"فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ","55:12":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ","55:13":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","55:14":"خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ","55:15":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ","55:16":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","55:17":"رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ","55:18":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}}