{"page":591,"juz":30,"hizb":59,"lines":[{"surah":86},{"basmala":true},{"segments":[["86:1","ﱁ ﱂ ﱃ"],["86:2","ﱄ ﱅ ﱆ ﱇ ﱈ"],["86:3","ﱉ ﱊ"]]},{"segments":[["86:3","ﱋ"],["86:4","ﱌ ﱍ ﱎ ﱏ ﱐ ﱑ ﱒ"],["86:5","ﱓ ﱔ ﱕ ﱖ ﱗ"]]},{"segments":[["86:6","ﱘ ﱙ ﱚ ﱛ ﱜ"],["86:7","ﱝ ﱞ ﱟ ﱠ ﱡ ﱢ"],["86:8","ﱣ ﱤ"]]},{"segments":[["86:8","ﱥ ﱦ ﱧ"],["86:9","ﱨ ﱩ ﱪ ﱫ"],["86:10","ﱬ ﱭ ﱮ ﱯ ﱰ ﱱ"]]},{"segments":[["86:10","ﱲ"],["86:11","ﱳ ﱴ ﱵ ﱶ"],["86:12","ﱷ ﱸ ﱹ ﱺ"],["86:13","ﱻ"]]},{"segments":[["86:13","ﱼ ﱽ ﱾ"],["86:14","ﱿ ﲀ ﲁ ﲂ"],["86:15","ﲃ ﲄ ﲅ ﲆ"]]},{"segments":[["86:16","ﲇ ﲈ ﲉ"],["86:17","ﲊ ﲋ ﲌ ﲍ ﲎ"]]},{"surah":87},{"basmala":true},{"segments":[["87:1","ﲏ ﲐ ﲑ ﲒ ﲓ"],["87:2","ﲔ ﲕ ﲖ ﲗ"],["87:3","ﲘ ﲙ ﲚ"]]},{"segments":[["87:3","ﲛ"],["87:4","ﲜ ﲝ ﲞ ﲟ"],["87:5","ﲠ ﲡ ﲢ ﲣ"],["87:6","ﲤ"]]},{"segments":[["87:6","ﲥ ﲦ ﲧ"],["87:7","ﲨ ﲩ ﲪ ﲫﲬ ﲭ ﲮ ﲯ ﲰ ﲱ ﲲ"],["87:8","ﲳ"]]},{"segments":[["87:8","ﲴ ﲵ"],["87:9","ﲶ ﲷ ﲸ ﲹ ﲺ"],["87:10","ﲻ ﲼ ﲽ ﲾ"]]}],"verses":{"86:1":" وَٱلسَّمَآءِ وَٱلطَّارِقِ","86:2":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","86:3":"ٱلنَّجْمُ ٱلثَّاقِبُ","86:4":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","86:5":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","86:6":"خُلِقَ مِن مَّآءٍ دَافِقٍ","86:7":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","86:8":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","86:9":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","86:10":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","86:11":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","86:12":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","86:13":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","86:14":"وَمَا هُوَ بِٱلْهَزْلِ","86:15":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","86:16":"وَأَكِيدُ كَيْدًا","86:17":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","87:1":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","87:2":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","87:3":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","87:4":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","87:5":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","87:6":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","87:7":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","87:8":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","87:9":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","87:10":"سَيَذَّكَّرُ مَن يَخْشَىٰ"}}