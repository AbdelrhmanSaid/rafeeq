{"page":535,"juz":27,"hizb":54,"lines":[{"segments":[["56:17","ﱁ ﱂ ﱃ ﱄ ﱅ"],["56:18","ﱆ ﱇ ﱈ ﱉ ﱊ"]]},{"segments":[["56:18","ﱋ"],["56:19","ﱌ ﱍ ﱎ ﱏ ﱐ ﱑ"],["56:20","ﱒ ﱓ ﱔ"]]},{"segments":[["56:20","ﱕ"],["56:21","ﱖ ﱗ ﱘ ﱙ ﱚ"],["56:22","ﱛ ﱜ ﱝ"],["56:23","ﱞ ﱟ"]]},{"segments":[["56:23","ﱠ ﱡ"],["56:24","ﱢ ﱣ ﱤ ﱥ ﱦ"],["56:25","ﱧ ﱨ ﱩ ﱪ"]]},{"segments":[["56:25","ﱫ ﱬ ﱭ"],["56:26","ﱮ ﱯ ﱰ ﱱ ﱲ"],["56:27","ﱳ ﱴ ﱵ ﱶ"]]},{"segments":[["56:27","ﱷ ﱸ"],["56:28","ﱹ ﱺ ﱻ ﱼ"],["56:29","ﱽ ﱾ ﱿ"],["56:30","ﲀ ﲁ"]]},{"segments":[["56:30","ﲂ"],["56:31","ﲃ ﲄ ﲅ"],["56:32","ﲆ ﲇ ﲈ"],["56:33","ﲉ ﲊ ﲋ ﲌ"]]},{"segments":[["56:33","ﲍ"],["56:34","ﲎ ﲏ ﲐ"],["56:35","ﲑ ﲒ ﲓ ﲔ"],["56:36","ﲕ ﲖ"]]},{"segments":[["56:36","ﲗ"],["56:37","ﲘ ﲙ ﲚ"],["56:38","ﲛ ﲜ ﲝ"],["56:39","ﲞ ﲟ ﲠ ﲡ"]]},{"segments":[["56:40","ﲢ ﲣ ﲤ ﲥ"],["56:41","ﲦ ﲧ ﲨ ﲩ ﲪ"]]},{"segments":[["56:41","ﲫ"],["56:42","ﲬ ﲭ ﲮ ﲯ"],["56:43","ﲰ ﲱ ﲲ ﲳ"],["56:44","ﲴ ﲵ"]]},{"segments":[["56:44","ﲶ ﲷ ﲸ"],["56:45","ﲹ ﲺ ﲻ ﲼ ﲽ ﲾ"],["56:46","ﲿ"]]},{"segments":[["56:46","ﳀ ﳁ ﳂ ﳃ ﳄ"],["56:47","ﳅ ﳆ ﳇ ﳈ ﳉ"]]},{"segments":[["56:47","ﳊ ﳋ ﳌ ﳍ ﳎ"],["56:48","ﳏ ﳐ ﳑ"],["56:49","ﳒ ﳓ"]]},{"segments":[["56:49","ﳔ ﳕ ﳖ"],["56:50","ﳗ ﳘ ﳙ ﳚ ﳛ ﳜ"]]}],"verses":{"56:17":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ","56:18":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ","56:19":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","56:20":"وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ","56:21":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ","56:22":"وَحُورٌ عِينٌ","56:23":"كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","56:24":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","56:25":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا","56:26":"إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا","56:27":"وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ","56:28":"فِى سِدْرٍ مَّخْضُودٍ","56:29":"وَطَلْحٍ مَّنضُودٍ","56:30":"وَظِلٍّ مَّمْدُودٍ","56:31":"وَمَآءٍ مَّسْكُوبٍ","56:32":"وَفَـٰكِهَةٍ كَثِيرَةٍ","56:33":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ","56:34":"وَفُرُشٍ مَّرْفُوعَةٍ","56:35":"إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً","56:36":"فَجَعَلْنَـٰهُنَّ أَبْكَارًا","56:37":"عُرُبًا أَتْرَابًا","56:38":"لِّأَصْحَـٰبِ ٱلْيَمِينِ","56:39":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ","56:40":"وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ","56:41":"وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ","56:42":"فِى سَمُومٍ وَحَمِيمٍ","56:43":"وَظِلٍّ مِّن يَحْمُومٍ","56:44":"لَّا بَارِدٍ وَلَا كَرِيمٍ","56:45":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","56:46":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","56:47":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ","56:48":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","56:49":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ","56:50":"لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ"}}