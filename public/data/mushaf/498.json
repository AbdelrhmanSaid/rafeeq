{"page":498,"juz":25,"hizb":50,"lines":[{"segments":[["44:40","ﱁ ﱂ ﱃ ﱄ ﱅ ﱆ"],["44:41","ﱇ ﱈ ﱉ ﱊ"]]},{"segments":[["44:41","ﱋ ﱌ ﱍ ﱎ ﱏ ﱐ ﱑ"],["44:42","ﱒ ﱓ ﱔ ﱕﱖ"]]},{"segments":[["44:42","ﱗ ﱘ ﱙ ﱚ ﱛ"],["44:43","ﱜ ﱝ ﱞ ﱟ"],["44:44","ﱠ"]]},{"segments":[["44:44","ﱡ ﱢ"],["44:45","ﱣ ﱤ ﱥ ﱦ ﱧ"],["44:46","ﱨ"]]},{"segments":[["44:46","ﱩ ﱪ"],["44:47","ﱫ ﱬ ﱭ ﱮ ﱯ ﱰ"],["44:48","ﱱ"]]},{"segments":[["44:48","ﱲ ﱳ ﱴ ﱵ ﱶ ﱷ ﱸ"],["44:49","ﱹ ﱺ"]]},{"segments":[["44:49","ﱻ ﱼ ﱽ ﱾ"],["44:50","ﱿ ﲀ ﲁ ﲂ ﲃ ﲄ"]]},{"segments":[["44:50","ﲅ"],["44:51","ﲆ ﲇ ﲈ ﲉ ﲊ ﲋ"],["44:52","ﲌ ﲍ ﲎ"]]},{"segments":[["44:52","ﲏ"],["44:53","ﲐ ﲑ ﲒ ﲓ ﲔ ﲕ"]]},{"segments":[["44:54","ﲖ ﲗ ﲘ ﲙ ﲚ"],["44:55","ﲛ ﲜ ﲝ"]]},{"segments":[["44:55","ﲞ ﲟ ﲠ"],["44:56","ﲡ ﲢ ﲣ ﲤ ﲥ"]]},{"segments":[["44:56","ﲦ ﲧﲨ ﲩ ﲪ ﲫ ﲬ"],["44:57","ﲭ ﲮ"]]},{"segments":[["44:57","ﲯﲰ ﲱ ﲲ ﲳ ﲴ ﲵ"],["44:58","ﲶ ﲷ ﲸ"]]},{"segments":[["44:58","ﲹ ﲺ ﲻ"],["44:59","ﲼ ﲽ ﲾ ﲿ"]]},{"surah":45}],"verses":{"44:40":"إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَـٰتُهُمْ أَجْمَعِينَ","44:41":"يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًى شَيْـًٔا وَلَا هُمْ يُنصَرُونَ","44:42":"إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","44:43":"إِنَّ شَجَرَتَ ٱلزَّقُّومِ","44:44":"طَعَامُ ٱلْأَثِيمِ","44:45":"كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ","44:46":"كَغَلْىِ ٱلْحَمِيمِ","44:47":"خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ","44:48":"ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ","44:49":"ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ","44:50":"إِنَّ هَـٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ","44:51":"إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍ","44:52":"فِى جَنَّـٰتٍ وَعُيُونٍ","44:53":"يَلْبَسُونَ مِن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَقَـٰبِلِينَ","44:54":"كَذَٰلِكَ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍ","44:55":"يَدْعُونَ فِيهَا بِكُلِّ فَـٰكِهَةٍ ءَامِنِينَ","44:56":"لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ","44:57":"فَضْلًا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","44:58":"فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ","44:59":"فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ"}}