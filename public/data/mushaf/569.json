{"page":569,"juz":29,"hizb":57,"lines":[{"segments":[["70:11","ﱁﱂ ﱃ ﱄ ﱅ ﱆ ﱇ ﱈ ﱉ ﱊ ﱋ"]]},{"segments":[["70:12","ﱌ ﱍ ﱎ"],["70:13","ﱏ ﱐ ﱑ ﱒ"],["70:14","ﱓ ﱔ ﱕ ﱖ"]]},{"segments":[["70:14","ﱗ ﱘ ﱙ"],["70:15","ﱚﱛ ﱜ ﱝ ﱞ"],["70:16","ﱟ ﱠ ﱡ"],["70:17","ﱢ ﱣ ﱤ"]]},{"segments":[["70:17","ﱥ ﱦ"],["70:18","ﱧ ﱨ ﱩ"],["70:19","ﱪ ﱫ ﱬ ﱭ ﱮ ﱯ"],["70:20","ﱰ ﱱ ﱲ"]]},{"segments":[["70:20","ﱳ ﱴ"],["70:21","ﱵ ﱶ ﱷ ﱸ ﱹ"],["70:22","ﱺ ﱻ ﱼ"],["70:23","ﱽ ﱾ"]]},{"segments":[["70:23","ﱿ ﲀ ﲁ ﲂ"],["70:24","ﲃ ﲄ ﲅ ﲆ ﲇ ﲈ"],["70:25","ﲉ"]]},{"segments":[["70:25","ﲊ ﲋ"],["70:26","ﲌ ﲍ ﲎ ﲏ ﲐ"],["70:27","ﲑ ﲒ ﲓ ﲔ"]]},{"segments":[["70:27","ﲕ ﲖ ﲗ"],["70:28","ﲘ ﲙ ﲚ ﲛ ﲜ ﲝ"],["70:29","ﲞ ﲟ"]]},{"segments":[["70:29","ﲠ ﲡ ﲢ"],["70:30","ﲣ ﲤ ﲥ ﲦ ﲧ ﲨ ﲩ"]]},{"segments":[["70:30","ﲪ ﲫ ﲬ ﲭ"],["70:31","ﲮ ﲯ ﲰ ﲱ ﲲ ﲳ ﲴ ﲵ"]]},{"segments":[["70:32","ﲶ ﲷ ﲸ ﲹ ﲺ ﲻ"],["70:33","ﲼ ﲽ ﲾ ﲿ"]]},{"segments":[["70:33","ﳀ"],["70:34","ﳁ ﳂ ﳃ ﳄ ﳅ ﳆ"],["70:35","ﳇ ﳈ ﳉ ﳊ ﳋ"]]},{"segments":[["70:36","ﳌ ﳍ ﳎ ﳏ ﳐ ﳑ"],["70:37","ﳒ ﳓ ﳔ ﳕ"]]},{"segments":[["70:37","ﳖ ﳗ"],["70:38","ﳘ ﳙ ﳚ ﳛ ﳜ ﳝ ﳞ ﳟ ﳠ"],["70:39","ﳡﳢ ﳣ ﳤ"]]},{"segments":[["70:39","ﳥ ﳦ ﳧ"],["70:40","ﳨ ﳩ ﳪ ﳫ ﳬ ﳭ ﳮ ﳯ"]]}],"verses":{"70:11":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","70:12":"وَصَـٰحِبَتِهِۦ وَأَخِيهِ","70:13":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ","70:14":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ","70:15":"كَلَّآ ۖ إِنَّهَا لَظَىٰ","70:16":"نَزَّاعَةً لِّلشَّوَىٰ","70:17":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ","70:18":"وَجَمَعَ فَأَوْعَىٰٓ","70:19":"۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا","70:20":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا","70:21":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","70:22":"إِلَّا ٱلْمُصَلِّينَ","70:23":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","70:24":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ","70:25":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ","70:26":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ","70:27":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","70:28":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ","70:29":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ","70:30":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","70:31":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ","70:32":"وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","70:33":"وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ","70:34":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ","70:35":"أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ","70:36":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ","70:37":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","70:38":"أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ","70:39":"كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ","70:40":"فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ"}}